<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">
    <!--
        Added the constraints for entity ProRequest.
    -->
    <changeSet id="20190814164943-2" author="jhipster">
        
        <addForeignKeyConstraint baseColumnNames="company_type_id"
                                 baseTableName="pro_request"
                                 constraintName="fk_pro_request_company_type_id"
                                 referencedColumnNames="id"
                                 referencedTableName="company_type"/>

        <addForeignKeyConstraint baseColumnNames="customer_id"
                                 baseTableName="pro_request"
                                 constraintName="fk_pro_request_customer_id"
                                 referencedColumnNames="id"
                                 referencedTableName="customer"/>

    </changeSet>
</databaseChangeLog>
