entity Company {
	name String
    creationDate LocalDate
}

entity Professional {
	firstName String
    lastName String
    creationDate LocalDate
    up Boolean
    active Boolean
}

entity Customer {
	firstName String
    lastName String
    deviceRegistrationId String
    phoneNumber String
    location String
}

entity CompanyType{
	type String
}

entity SubscriptionType{
	type String
}

entity ProfessionalDetails{
	phoneNumber String
	hourlyRate Double
    onMobility Boolean
}

entity CompanyLocation{
	adresse String
    lat Double
    lng Double
}

entity ProRequest{
	location String
    deviceRegistrationId String
    date LocalDate
}

entity ProChoice{
	location String
    deviceRegistrationId String
    date LocalDate
}

entity Rating{
	value Double
    date LocalDate
    comment String
}

entity ProfessionalAudit{
	date LocalDate
    message String
    event ProfessionalEvent
}

enum ProfessionalEvent {
	AVAILABLE, NOT_AVAILABLE
}

entity Bill {
	date LocalDate
    amountDue Double
    status BillStatus
}

entity BillAudit {
	date LocalDate
    message String
    event BillEvent
}

enum BillEvent {
	START, END, SEND, RESEND, PAID, ERROR, CANCEL
}

enum BillStatus {
	RUN, SEND, DUE, LATE, PAID, ERROR, CANCEL
}

entity Hit {
	date LocalDate
    answered Boolean
    transformed Boolean
}

entity Summary{
	hits Integer
    missed Integer
    currentBill Double
    rating Double
}

relationship ManyToOne {
	Company{companyType} to CompanyType
    Company{subscriptionType} to SubscriptionType
    ProRequest{companyType} to CompanyType
    Rating{company} to Professional
    ProfessionalAudit{professional} to Professional
    BillAudit{bill} to Bill
    Bill{company} to Company
    Hit{professional} to Professional
    Hit{customer} to Customer
}

relationship OneToMany {
	Customer{requests} to ProRequest{customer}
    Customer{choices} to ProChoice{customer}
    Company{locations} to CompanyLocation{company}
    CompanyLocation{professionals} to Professional{location}
    
    
}

relationship OneToOne {
	ProChoice{choice} to Professional
    ProChoice{request} to ProRequest
    ProChoice{rating} to Rating
    Professional{details} to ProfessionalDetails
}

// Set pagination options
//paginate JobHistory, Employee with infinite-scroll
//paginate Job with pagination

// Use Data Transfert Objects (DTO)
dto * with mapstruct

// Set service options to all except few
service all with serviceImpl 

// Set an angular suffix
// angularSuffix * with mySuffix
